# ── Сервер ─────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Источник, которому разрешён CORS (адрес фронтенда на Vite)
CORS_ORIGIN=http://localhost:5173

# ── База данных ────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/helpdesk?schema=public"

# ── JWT ────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# ── LDAP / Active Directory ────────────────────────────────────────────
# Начальные значения. После сохранения настроек в веб-интерфейсе
# (Конфигурация → LDAP / Active Directory) бэкенд берёт их из БД (таблица ldap_settings),
# а эти переменные снова используются только после «Сбросить к .env».
LDAP_URL=ldap://dc.org.local:389
# Шаблон bind-имени для проверки пароля пользователя.
# {username} подставляется из формы входа. Для AD обычно UPN:
LDAP_BIND_TEMPLATE={username}@org.local
# База поиска и фильтр для получения атрибутов профиля
LDAP_SEARCH_BASE=DC=org,DC=local
LDAP_SEARCH_FILTER=(sAMAccountName={username})
# Сопоставление групп AD → роли (CN или подстрока DN группы)
LDAP_GROUP_SUPERADMIN=HelpDesk-SuperAdmins
LDAP_GROUP_ADMIN=HelpDesk-Admins
LDAP_GROUP_IT=HelpDesk-IT
# Группа, дающая флаг управления бронями (необязательно)
LDAP_GROUP_BOOKING_MANAGERS=HelpDesk-BookingManagers

# Массовая синхронизация (Конфигурация → LDAP → «Синхронизировать»).
# Сервисная учётка с правом чтения каталога, bind по полному DN (не по шаблону логина).
# Если оставить пустыми — синхронизация попробует анонимный bind (только для тестовых каталогов).
LDAP_SYNC_BIND_DN="CN=svc-helpdesk-sync,OU=Service Accounts,DC=org,DC=local"
LDAP_SYNC_BIND_PASSWORD=change-me
# Фильтр выборки всех сотрудников. При необходимости исключите отключённые
# учётные записи, например добавив (!(userAccountControl:1.2.840.113556.1.4.803:=2))
LDAP_SYNC_FILTER=(&(objectClass=user)(objectCategory=person))

# ── Режим разработки без AD ─────────────────────────────────────────────
# Если true — вход проходит по userName из БД без обращения к LDAP (пароль игнорируется).
# Удобно, пока нет доступа к контроллеру домена. В проде ОБЯЗАТЕЛЬНО false.
AUTH_DEV_BYPASS=true

# ── SLA: рабочий график ─────────────────────────────────────────────────
# Часы SLA тикают только в рабочее время (в этом часовом поясе).
SLA_TIMEZONE=Europe/Moscow
SLA_WORK_DAYS=1,2,3,4,5
SLA_WORK_START=09:00
SLA_WORK_END=18:00
